generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  MANAGER
  CASHIER
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskLabel {
  BUG
  FEATURE
  DOCUMENTATION
}

model User {
  id           String       @id @default(cuid())
  firstName    String       @default("") @map("first_name")
  lastName     String       @default("") @map("last_name")
  username     String       @unique
  email        String       @unique
  phoneNumber  String?      @map("phone_number")
  passwordHash String       @map("password_hash")
  role         UserRole     @default(USER)
  status       UserStatus   @default(ACTIVE)
  bio          String?      @db.VarChar(160)
  urls         Json         @default("[]")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  sessions     Session[]
  settings     UserSettings?
  createdTasks Task[]       @relation("task_creator")
  assignedTasks Task[]      @relation("task_assignee")
  activities   ActivityLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  theme               String   @default("system")
  font                String   @default("inter")
  direction           String   @default("ltr")
  layout              String   @default("default")
  sidebarState        Boolean  @default(true) @map("sidebar_state")
  notificationType    String   @default("all") @map("notification_type")
  mobileNotifications Boolean  @default(false) @map("mobile_notifications")
  communicationEmails Boolean  @default(false) @map("communication_emails")
  marketingEmails     Boolean  @default(false) @map("marketing_emails")
  socialEmails        Boolean  @default(true) @map("social_emails")
  securityEmails      Boolean  @default(true) @map("security_emails")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Task {
  id          String       @id @default(cuid())
  taskNumber  Int          @unique @default(autoincrement()) @map("task_number")
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  label       TaskLabel    @default(FEATURE)
  dueDate     DateTime?    @map("due_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  creatorId   String       @map("creator_id")
  assigneeId  String?      @map("assignee_id")
  creator     User         @relation("task_creator", fields: [creatorId], references: [id])
  assignee    User?        @relation("task_assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@index([assigneeId])
  @@map("tasks")
}

model DashboardMetric {
  id          String   @id @default(cuid())
  key         String
  value       Decimal  @db.Decimal(14, 2)
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([key, periodStart, periodEnd])
  @@index([key, periodEnd])
  @@map("dashboard_metrics")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("activity_logs")
}
